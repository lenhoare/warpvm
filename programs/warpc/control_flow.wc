/* Warp C v0.1.4 Slice B: structured uniform control flow. */
int main(void)
{
    int sum = 0;
    int i = 0;
    int flag = 0;

    if (1)
        sum += 1;
    else
        sum = 100;

    if (0) {
        sum = 100;
    } else {
        sum += 2;
    }

    while (i < 10) {
        ++i;
        if (i == 3)
            continue;
        if (i == 8)
            break;
        sum += i;
    }

    do {
        sum += 2;
        --i;
    } while (i > 6);

    for (int j = 0; j < 8; ++j) {
        if (j == 2)
            continue;
        if (j == 6)
            break;
        sum += j;
    }

    /* Expression initializers and omitted for clauses. */
    for (i = 0; i < 1; ++i)
        sum += 1;
    sum -= 1;
    for (;;) {
        sum += 1;
        break;
    }
    sum -= 1;

    /* The else belongs to the inner if. */
    if (1)
        if (0)
            flag = 100;
        else
            flag = 3;

    return sum - flag; /* 45 - 3 = 42 */
}
