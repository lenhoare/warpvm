/* Warp C v0.1.4 Slice B: switch dispatch, fall-through and default. */
int main(void)
{
    uniform int sum = 0;
    uniform int value = 2;

    switch (value) {
    case 0:
        sum = 100;
        break;
    case 1:
        sum += 1;
        /* fall through */
    case 2:
        sum += 20;
        /* fall through */
    case 3:
        sum += 3;
        break;
    default:
        sum = 200;
    }

    switch (9) {
    case 7:
        sum = 100;
        break;
    default:
        sum += 10;
        break;
    }

    switch (-1) {
    case -1:
        sum += 4;
        break;
    default:
        sum = 100;
    }

    switch (5) {
    default:
        sum += 5;
        break;
    case 6:
        sum = 100;
    }

    /* break exits only the switch; continue still targets the for loop. */
    uniform int nested = 0;
    for (uniform int i = 0; i < 4; ++i) {
        switch (i) {
        case 0:
            continue;
        case 1:
            nested += 10;
            break;
        default:
            nested += 1;
            break;
        }
        nested += 2;
    }

    return sum + (nested == 18) - 1; /* 42 + 1 - 1 = 42 */
}
