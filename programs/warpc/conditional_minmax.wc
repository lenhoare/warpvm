#include <warp.h>

/* Regression exercise drawn from compare-select patterns in bitonic sorting,
 * argsort key selection, and Mandelbrot colour selection. */
int main(void)
{
    uniform int failures = 0;

    /* ?: has lower precedence than arithmetic and associates to the right. */
    uniform int precedence = 1 + 2 ? 7 : 9;
    uniform int nested = 0 ? 1 : 0 ? 2 : 3;
    if (precedence != 7 || nested != 3)
        failures = 1;

    /* A uniform condition must execute only the selected side-effecting arm. */
    uniform int uniform_side = 0;
    uniform int uniform_value = warp_vm_id() == 0
        ? (uniform_side += 2)
        : (uniform_side += 100);
    if (warp_vm_id() == 0) {
        if (uniform_value != 2 || uniform_side != 2)
            failures = 2;
    } else if (uniform_value != 100 || uniform_side != 100) {
        failures = 3;
    }
    uniform int uniform_false_side = 0;
    uniform int uniform_false_value = 0
        ? (uniform_false_side += 100)
        : (uniform_false_side += 3);
    if (uniform_false_value != 3 || uniform_false_side != 3)
        failures = 14;

    /* Divergent selection must guard both the result and arm side effects. */
    int left_hits = 0;
    int right_hits = 0;
    int selected = WARP < 16 ? (left_hits += 1) : (right_hits += 1);
    if (!warp_all(selected == 1))
        failures = 4;
    if (warp_ballot(left_hits == 1) != 0x0000ffffu)
        failures = 5;
    if (warp_ballot(right_hits == 1) != 0xffff0000u)
        failures = 6;

    /* Signed and unsigned boundary/equality cases. */
    uniform int signed_low = -2147483647 - 1;
    if (min(signed_low, 2147483647) != signed_low)
        failures = 7;
    if (max(signed_low, 2147483647) != 2147483647)
        failures = 8;
    if (!warp_all((min(WARP, WARP) == WARP) & (max(WARP, WARP) == WARP)))
        failures = 9;
    if (min(0x80000000u, 0x7fffffffu) != 0x7fffffffu)
        failures = 10;
    if (max(0x80000000u, 0x7fffffffu) != 0x80000000u)
        failures = 11;

    /* Bitonic/argsort-style lane-varying compare-select. */
    int forward = WARP;
    int reverse = 31 - WARP;
    int low = min(forward, reverse);
    int high = max(forward, reverse);
    int expected_low = WARP < 16 ? forward : reverse;
    int expected_high = WARP < 16 ? reverse : forward;
    if (!warp_all((low == expected_low) & (high == expected_high)))
        failures = 12;

    /* Mandelbrot-style divergent colour selection. */
    int escaped = WARP * WARP > 100;
    uniform unsigned black = 0xff000000u;
    uniform unsigned white = 0xffffffffu;
    unsigned colour = escaped ? black : white;
    if (!warp_all(colour == (escaped ? black : white)))
        failures = 13;

    return failures ? 0 : 42;
}
