int main(void)
{
    uniform unsigned vm = warp_vm_id();
    unsigned lane = warp_lane_id();
    unsigned propagated = lane + 1;
    int result = 36;

    for (uniform int i = 0; i < 4; ++i)
        result += i;

    if (vm != warp_vm_id())
        result = 0;

    if (propagated > 32)
        result = 0;

    return result;
}
